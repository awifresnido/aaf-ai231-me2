  "decision_rule": {
    "rule": "Pre-registered: a fine-tuned model replaces its v1 parent in the app only if ALL: (1) every seed wrong<=1% on the tau set; (2) Awi s02 correct >= v1-1pt; (3) gold test speaker 201435283 correct >= v1+5pt; (4) Single Words FAR <= v1+1pt",
    "verdict": {
      "B2f": {
        "replace_v1": false,
        "failed_conditions": [
          "awi_s02_ge_v1_minus_1pt (88.9% vs 93.9%, -5.0pt)",
          "gold_test_ge_v1_plus_5pt (63.3% vs 61.5%, +1.9pt)"
        ]
      },
      "E1f": {
        "replace_v1": false,
        "failed_conditions": [
          "awi_s02_ge_v1_minus_1pt (91.4% vs 94.3%, -2.9pt)"
        ]
      },
      "G2f": {
        "replace_v1": false,
        "failed_conditions": [
          "awi_s02_ge_v1_minus_1pt (56.6% vs 63.1%, -6.5pt)",
          "gold_test_ge_v1_plus_5pt (11.0% vs 9.9%, +1.1pt)"
        ]
      }
    },
    "deployment_action": "Decision rule => RETAIN v1 models. HOWEVER Awi explicitly chose to keep E1f_s1 as the app default (documented deviation from the pre-registered rule): the fine-tunes improved the group test speaker (+17.7pt E1f) and cut false-accepts (Single Words FAR 2.06% -> 0.58%), at the cost of a 2.9pt Awi s02 regression that the rule's floor forbids.",
    "source": "results/me2_gold/decision.json"
  },
